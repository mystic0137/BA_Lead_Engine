# Byte-compiled / optimized / DLL files
/__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
venv/
ENV/
env/

# Secrets and Config
.env
.python-version

# Data and Artifacts (The "Heavy" Stuff)
data/chroma_db/*
data/finetuning/*

# Models (ONNX artifacts, configs)
models/*

# LRU: keep structure
!data/chroma_db/.gitkeep
!data/finetuning/.gitkeep
!models/.gitkeep

# HF model cache (downloaded at build time)
hf_models/*
!hf_models/.gitkeep

# uv lock file (project uses pip/requirements.txt for dep management)
uv.lock

# notebook cache
.ipynb_checkpoints

# Meta data
*.egg-info/

# Streamlit and UI
.streamlit/config.toml
.streamlit/secrets.toml

# OS and IDE
.DS_Store
.idea/
.vscode/
*.swp

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/